void encode_data(char *data) {
    while (*data != '\0') {
        *data = (*data ^ 0x5a) + 1;
        data++;
    }
}

void decode_data(char *data) {
    while (*data != '\0') {
        *data = (*data - 1) ^ 0x5a;
        data++;
    }
}

