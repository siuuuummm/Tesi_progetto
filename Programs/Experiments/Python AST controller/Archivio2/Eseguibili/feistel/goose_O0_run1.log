 * The main logic of the program.
 */
int main(void) {
    uint32_t local_14;
    uint32_t local_10;
    uint32_t local_c;

    local_10 = 0xdeadbeef;
    local_14 = 0xcafebabe;
    local_c = 0x12345678;

    printf("Originale: %08X %08X\n", 0xdeadbeef, 0xcafebabe);
    feistel_network(&local_10, &local_14, local_c);
    printf("Cifrato:   %08X %08X\n", (uint32_t)local_10, (uint32_t)local_14);

    return 0;
}


