/* Original name: FUN_004004b6
 * Copies a name into a fixed 16-byte buffer when its length is < 17,
 * otherwise returns NULL.
 */
char *register_name(char *name)
{
    size_t len;
    char *dest;

    len = strlen(name);
    dest = (char *)0x0;
    if (len < 0x11) {
        dest = (char *)malloc(0x10);
        strcpy(dest, name);
    }
    return dest;
}

/* Original name: FUN_004004f1 (main) */
