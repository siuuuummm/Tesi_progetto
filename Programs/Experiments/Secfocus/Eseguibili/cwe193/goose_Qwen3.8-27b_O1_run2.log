        do {
            s = *p;
            result = register_name(s);
            if (result == (char *)0x0) {
                len = strlen(s);
                printf("Nome troppo lungo: %zu caratteri\n", len);
            }
            else {
                len = strlen(result);
                printf("Registrato: %s (%zu caratteri)\n", result, len);
                free(result);
            }
            p = p + 1;
        } while (p != &argv[argc]);
    }
    return 0;
}


