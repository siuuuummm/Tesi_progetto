    copy = NULL;
    if (len < 0x11) {
        copy = malloc(0x10);
        strcpy(copy, name);
    }
    return copy;
}

int main(int argc, char **argv)
{
    char *name;
    char *copy;
    size_t len;
    char **cursor;

    setvbuf(stdout, NULL, 2, 0);
    if (1 < argc) {
        cursor = (char **)((char *)argv + 8);
        do {
            name = *cursor;
            copy = register_name(name);
