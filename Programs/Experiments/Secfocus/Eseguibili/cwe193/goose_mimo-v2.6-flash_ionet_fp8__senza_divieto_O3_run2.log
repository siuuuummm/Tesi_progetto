    content: #include <stdio.h>
#include <stdint.h>
#include <stdlib.h>
#include <string.h>

/* FUN_004003c0 - entry point del programma (main).
 *
 * setvbuf(stdout, NULL, _IONBF, 0);
 * poi, per ogni argv[1..argc-1]:
 *   - len = strlen(arg)
 *   - se len > 16 -> printf("Nome troppo lungo: %zu caratteri\n", len)
 *   - altrimenti: malloc(16), copia di len+1 byte (memcpy inline),
 *     printf("Registrato: %s (%zu caratteri)\n", copy, len), free(copy)
 */
int main(int argc, char **argv)
{
    int i;
    size_t len;
    char *copy;
    size_t remaining;
    size_t off;
    char *src;
    char *dst;

    setvbuf(stdout, NULL, _IONBF, 0);

    if (argc > 1) {
        for (i = 1; i < argc; i++) {
            src = argv[i];
            len = strlen(src);
            if (len > 16) {
                printf("Nome troppo lungo: %zu caratteri\n", len);
            } else {
                copy = (char *)malloc(16);
                remaining = len + 1;
                if (remaining < 8) {
                    if (remaining != 0) {
                        copy[0] = src[0];
                        if (remaining >= 2) {
                            memcpy(copy + remaining - 2, src + remaining - 2, 2);
                        }
                    }
                } else {
                    memcpy(copy + remaining - 8, src + remaining - 8, 8);
                    remaining &= ~(size_t)7;
                    for (off = 0; off < remaining; off += 8) {
                        memcpy(copy + off, src + off, 8);
                    }
                }
                printf("Registrato: %s (%zu caratteri)\n", copy, len);
                free(copy);
            }
        }
    }
    return 0;
}

/* FUN_004005e0 - helper che duplica un nome corto.
 * Stessa logica di copia di main (memcpy inline su len+1 byte dentro un
 * buffer mallocato di 16 byte); restituisce NULL se strlen(s) > 16. */
char *duplicate_short_name(const char *s)
{
    size_t len;
    char *copy;
    size_t remaining;
    size_t off;
    char *src;
    char *dst;

    src = (char *)s;
    len = strlen(src);
    copy = NULL;
    if (len > 16) {
        return copy;
    }
    copy = (char *)malloc(16);
    remaining = len + 1;
    if (remaining < 8) {
        if (remaining != 0) {
            copy[0] = src[0];
            if (remaining >= 2) {
                memcpy(copy + remaining - 2, src + remaining - 2, 2);
            }
        }
    } else {
        memcpy(copy + remaining - 8, src + remaining - 8, 8);
        remaining &= ~(size_t)7;
        for (off = 0; off < remaining; off += 8) {
            memcpy(copy + off, src + off, 8);
        }
    }
    return copy;
}


