#include <stdlib.h>
#include <string.h>
#include <stdint.h>

/* strdup-like helper: copies the string only if its length is < 0x11 (17).
   Allocates exactly 0x10 (16) bytes. Returns NULL when the name is too long. */
static char *duplicate_short_name(const char *name)
{
    size_t len;
    char *dest;

    len = strlen(name);
    dest = NULL;
    if (len < 0x11) {
        dest = (char *)malloc(0x10);
        strcpy(dest, name);
    }
    return dest;
}

int main(int argc, long *argv)
{
    char *arg;
    char *copy;
    size_t len;

    setvbuf(stdout, (char *)0x0, 2, 0);
    if (1 < argc) {
        long *p = argv + 1;
        long *end = argv + 2 + (long)(argc - 2);

        do {
            arg = (char *)*p;
            copy = duplicate_short_name(arg);
            if (copy == (char *)0x0) {
                len = strlen(arg);
                printf("Nome troppo lungo: %zu caratteri\n", len);
            } else {
                len = strlen(copy);
                printf("Registrato: %s (%zu caratteri)\n", copy, len);
                free(copy);
            }
            p = p + 1;
        } while (p != end);
    }
    return 0;
}


