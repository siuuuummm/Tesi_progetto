    *(int *)(dest + 0x1c) = 1000;
    printf("Sessione %d aperta per %s\n", 1000, dest);

    int is_logout = strcmp(argv[2], "logout");
    if (is_logout == 0) {
        free(dest);
        puts("Logout eseguito");
    }

    if (argc != 3) {
        strtol(argv[3], NULL, 10);
    }

    if (*(int *)(dest + 0x18) == 0) {
        printf("Accesso utente per %s\n", dest);
    } else {
        printf("Accesso amministratore per %s\n", dest);
    }

    if (is_logout != 0) {
        free(dest);
    }

    return 0;
}


