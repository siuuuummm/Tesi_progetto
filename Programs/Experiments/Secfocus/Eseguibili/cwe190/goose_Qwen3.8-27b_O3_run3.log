static int a[4] = {0,1,2,3};
static int b[4] = {1,1,1,1};
static int c[4] = {4,4,4,4};
int main(int argc, char **argv){
    if (argc < 2) return 1;
    setvbuf(stdout, NULL, 2, 0);
    long n64 = strtol(argv[1], 0, 10);
