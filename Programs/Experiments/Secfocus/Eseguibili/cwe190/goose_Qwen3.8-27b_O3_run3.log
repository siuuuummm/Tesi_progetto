    n64 = strtol(argv[1], 0, 10);
    n = (unsigned int)n64;

    if (100 < n) {
        puts("Troppi elementi");
        return 1;
    }

    buf = (int *)malloc((unsigned long)(n * 4 & 0xff));
    printf("Elementi: %u, byte allocati: %u\n", n, (unsigned char)(n * 4));

    sum = n;
    if (n != 0) {
        if (n - 1 < 4) {
            rem = 0;
            sum = 0;
        } else {
            int s0 = 0; /* iVar18 */
            int s1 = 0; /* iVar20 */
            int s2 = 0; /* iVar21 */
            int s3 = 0; /* iVar22 */
            int *p;     /* piVar12 */
            int *q;     /* piVar13 */
            int a0, a1, a2, a3; /* iVar23..iVar26 (lanes of a) */
            int b0, b1, b2, b3; /* iVar1..iVar4   (lanes of b) */
            int c0, c1, c2, c3; /* iVar5..iVar8   (lanes of c) */
            int x0, x1, x2, x3; /* iVar14..iVar17 */

            a0 = a[0];
            a1 = a[1];
            a2 = a[2];
            a3 = a[3];
            b0 = b[0];
            b1 = b[1];
            b2 = b[2];
            b3 = b[3];
            c0 = c[0];
            c1 = c[1];
            c2 = c[2];
            c3 = c[3];
            p = buf;
            do {
                q = p + 4;
                x0 = a0 * 3 + b0;
                x1 = a1 * 3 + b1;
                x2 = a2 * 3 + b2;
                x3 = a3 * 3 + b3;
                a0 = a0 + c0;
                a1 = a1 + c1;
                a2 = a2 + c2;
                a3 = a3 + c3;
                p[0] = x0;
                p[1] = x1;
                p[2] = x2;
                p[3] = x3;
                s0 = s0 + x0;
                s1 = s1 + x1;
                s2 = s2 + x2;
                s3 = s3 + x3;
                p = q;
            } while (buf + ((n >> 2) & 0x3fffffff) * 4 != q);
            sum = (unsigned int)(s0 + s2 + s1 + s3);
            if ((n & 3) == 0)
                goto print_sum;
            rem = n & 0xfffffffc;
        }
        r0 = (int)(rem * 3);
        sum = (unsigned int)(r0 + 1 + sum);
        if (((rem + 1 < n) && (sum = (unsigned int)(r0 + 4 + sum), rem + 2 < n)) &&
            (sum = (unsigned int)(r0 + 7 + sum), rem + 3 < n)) {
            sum = (unsigned int)(r0 + 10 + sum);
        }
    }

print_sum:
    printf("Somma: %u\n", (unsigned long)sum);
    free(buf);
    return 0;
}


