The main loop is SSE2-vectorized and the horizontal reduction needs closer analysis. Let me instrument a test replicating the exact assembly to pin down the true semantics:


  ────────────────────────────────────────
  ▸ shell
    command: cd /tmp/re_task_mgp_rv7d && cat > /tmp/trace.c <<'EOF'
#include <stdio.h>
#include <stdint.h>
#include <string.h>
#include <stdlib.h>
int main(int argc, char**argv){
    long n = atol(argv[1]);
    uint32_t a[4]={0,1,2,3}, b[4]={1,1,1,1}, c[4]={4,4,4,4}, sum[4]={0};
    // exact SIMD semantics: lanes parallel
    for(long m=0;m<n/4;m++){
        uint32_t v[4];
        for(int k=0;k<4;k++){ v[k]=a[k]*2 + a[k] + b[k]; a[k]+=c[k]; sum[k]+=v[k]; }
    }
    // horizontal reduction as in asm:
    uint32_t x0[4]={sum[0],sum[1],sum[2],sum[3]};
    for(int i=3;i>0;i--) x0[i]=x0[i-1]; x0[0]=0;               // psrldq 8
    for(int k=0;k<4;k++) sum[k]+=x0[k];                          // paddd
    uint32_t x1[4]={sum[0],sum[1],sum[2],sum[3]};
    for(int i=3;i>0;i--) x1[i]=x1[i-1]; x1[0]=0;               // psrldq 4
    for(int k=0;k<4;k++) sum[k]+=x1[k];
    printf("lanes: %u %u %u %u  lane0=%u\n",sum[0],sum[1],sum[2],sum[3],sum[0]);
    return 0;
}
EOF
