int main(int argc, char *argv[])
{
    unsigned long long n64; /* uVar11: strtol result (64 bit) */
    unsigned int n;         /* uVar9: (uint)n64 */
    int *buf;               /* __ptr */
    unsigned int sum;       /* uVar19 */
