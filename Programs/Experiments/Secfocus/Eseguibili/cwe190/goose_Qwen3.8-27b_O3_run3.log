            sum = s0+s1+s2+s3;
            if ((n&3)==0) goto out;
            rem = n & 0xfffffffcu;
        }
        int r0 = (int)(rem*3);
        sum = (unsigned)(r0+1+sum);
        if (((rem+1 < n) && (sum=(unsigned)(r0+4+sum), rem+2 < n))
             && (sum=(unsigned)(r0+7+sum), rem+3 < n))
            sum = (unsigned)(r0+10+sum);
    }
out:
    printf("Somma: %u\n", (unsigned long)sum);
    free(buf);
    return 0;
}
