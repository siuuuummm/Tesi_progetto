import subprocess, re

def dis(bin):
    return subprocess.run(["objdump","-d","-M","intel",bin],capture_output=True,text=True).stdout.splitlines()

def loop_block(lines):
    out, on = [], False
    for l in lines:
        if not on and re.match(r'^  40056[0-9a-f]:\s+[0-9a-f]{2} [0-9a-f]{2}\s+.*mov\s+(edx|eax|ecx|ebx),DWORD PTR \[rbp-0x8\]', l):
            on = True
        if on:
            out.append(re.sub(r'^  [0-9a-f]{6}:', '  A:', l))
            if re.match(r'^  A:\s+[0-9a-f]{2} [0-9a-f]{2}\s+.*\tjb\s', l):
                break
    return out

orig = loop_block(dis("test_O0"))
on = [re.sub(r'\b40[0-9a-f]{4}\b','A',l) for l in orig]

def gen(body, btype="int *"):
    src = f'''#include <stdio.h>
#include <stdlib.h>
int main(int argc, char *argv[]) {{
    if (argc < 2) {{ return 1; }}
    setvbuf(stdout, NULL, _IONBF, 0);
    unsigned int n = atoi(argv[1]);
    if (n > 100) {{ puts("Troppi elementi"); return 1; }}
    unsigned char size = n * sizeof(int);
    {btype} buf = malloc(size);
    printf("Elementi: %u, byte allocati: %u\\n", n, size);
    int sum = 0;
    unsigned int i;
    for (i = 0; i < n; i++) {{
        {body}
        sum += buf[i];
    }}
    printf("Somma: %u\\n", sum);
    free(buf);
    return 0;
}}
'''
    open("bv.c","w").write(src)
    r = subprocess.run(["gcc","-O0","-o","bv","bv.c"],capture_output=True,text=True)
    if r.returncode: return None
    b = loop_block(dis("bv"))
    return [re.sub(r'\b40[0-9a-f]{4}\b','A',l) for l in b]

tests = []
for bt in ["int *","unsigned int *","unsigned *"]:
    for body in ["buf[i] = i * 3 + 1;","buf[i] = 3 * i + 1;","buf[i] = i + i*2 + 1;",
                 "buf[i] = i*2 + i + 1;","*(buf + i) = i * 3 + 1;","*(buf+i) = i*3+1;",
                 "*(i + buf) = i*3 + 1;"]:
        tests.append((bt, body))
for bt, body in tests:
    b = gen(body, bt)
    if b is None:
        print("ERR |", bt, "|", body); continue
    if b == on:
        print("MATCH |", bt, "|", body)
    else:
        print("no    |", bt, "|", body)
