import subprocess, re, difflib

def dis(bin):
    return subprocess.run(["objdump","-d","-M","intel",bin],capture_output=True,text=True).stdout.splitlines()

def block(lines, start, stop):
    out=[]
    for l in lines:
        m = re.match(r'^  ([0-9a-f]{6}):', l)
        if m:
            a = int(m.group(1),16)
            if a >= stop: break
            if a >= start:
                out.append(l)
    return out

def norm(lines):
    out=[]
    for l in lines:
        m = re.match(r'^  [0-9a-f]{6}:', l)
        if m:
            out.append(re.sub(r'^  [0-9a-f]{6}:', '  A:', re.sub(r'\b40[0-9a-f]{4}\b','A',l)))
        else:
            out.append(l)
    return out

