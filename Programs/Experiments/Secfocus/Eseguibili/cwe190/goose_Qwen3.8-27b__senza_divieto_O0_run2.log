import subprocess, re

def lines_of(bin):
    t = subprocess.run(["objdump","-d","-M","intel",bin],capture_output=True,text=True).stdout
    return t.splitlines()

def loop_block(lines):
    out, on = [], False
    for l in lines:
        if re.match(r'^  4005[4-9a-f][0-9a-f]:\s+8[bc] [0-9a-f]{2},\[rbp-0x[48]\]', l):
            pass
        if re.match(r'^  4005[0-9a-f]{3}:.*mov\s+edx,DWORD PTR \[rbp-0x8\]', l):
            on = True
        if on:
            out.append(l)
            if re.match(r'^  4005[0-9a-f]{3}:.*jb', l):
                break
    return "\n".join(out)

orig = loop_block(lines_of("test_O0"))
print("=== ORIGINALE ===")
print(orig)

def gen(body):
    src = f'''#include <stdio.h>
#include <stdlib.h>
int main(int argc, char *argv[]) {{
    if (argc < 2) {{ return 1; }}
    setvbuf(stdout, NULL, _IONBF, 0);
    unsigned int n = atoi(argv[1]);
    if (n > 100) {{ puts("Troppi elementi"); return 1; }}
    unsigned char size = n * sizeof(int);
    int *buf = malloc(size);
    printf("Elementi: %u, byte allocati: %u\\n", n, size);
    int sum = 0;
    unsigned int i;
    for (i = 0; i < n; i++) {{
        {body}
        sum += buf[i];
    }}
    printf("Somma: %u\\n", sum);
    free(buf);
    return 0;
}}
'''
    open("bv.c","w").write(src)
    subprocess.run(["gcc","-O0","-o","bv","bv.c"],capture_output=True)
    return loop_block(lines_of("bv"))

