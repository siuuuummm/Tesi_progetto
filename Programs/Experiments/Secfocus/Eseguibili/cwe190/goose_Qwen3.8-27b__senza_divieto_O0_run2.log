#include <stdlib.h>

int main(int argc, char *argv[])
{
    if (argc < 2) {
        return 1;
    }
    setvbuf(stdout, NULL, _IOLBF, 0);
    int n = atoi(argv[1]);
    if (n > 100) {
        puts("Troppi elementi");
        return 1;
    }
    unsigned char size = n * sizeof(int);
    int *buf = malloc(size);
    printf("Elementi: %u, byte allocati: %u\n", n, size);
    int i;
    int sum = 0;
    for (i = 0; i < n; i++) {
        buf[i] = i * 3 + 1;
        sum += buf[i];
    }
    printf("Somma: %u\n", sum);
    free(buf);
    return 0;
}


