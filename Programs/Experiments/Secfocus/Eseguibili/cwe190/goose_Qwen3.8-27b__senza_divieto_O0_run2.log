import subprocess, re

def dis(bin):
    t = subprocess.run(["objdump","-d","-M","intel",bin],capture_output=True,text=True).stdout
    return t.splitlines()

def loop_block(lines):
    out, on = [], False
    for l in lines:
        if not on and re.match(r'^  40056[0-9a-f]:\s+8b 55 f8', l):
            on = True
        if on:
            out.append(l)
            if re.match(r'^  4005[0-9a-f]{3}:\s+[0-9a-f]{2} [0-9a-f]{2}\s+.*\tjb\s', l):
                break
    return out

orig = loop_block(dis("test_O0"))
print("ORIG (%d righe):" % len(orig))
for l in orig: print(l)
print()

def gen(body, sumstmt="sum += buf[i];"):
    src = f'''#include <stdio.h>
#include <stdlib.h>
int main(int argc, char *argv[]) {{
    if (argc < 2) {{ return 1; }}
    setvbuf(stdout, NULL, _IONBF, 0);
    unsigned int n = atoi(argv[1]);
    if (n > 100) {{ puts("Troppi elementi"); return 1; }}
    unsigned char size = n * sizeof(int);
    int *buf = malloc(size);
    printf("Elementi: %u, byte allocati: %u\\n", n, size);
    int sum = 0;
    unsigned int i;
    for (i = 0; i < n; i++) {{
        {body}
        {sumstmt}
    }}
    printf("Somma: %u\\n", sum);
    free(buf);
    return 0;
}}
'''
    open("bv.c","w").write(src)
    r = subprocess.run(["gcc","-O0","-o","bv","bv.c"],capture_output=True,text=True)
    if r.returncode:
        return None
    return loop_block(dis("bv"))

def norm(lines):
    # strip addresses and target addrs, keep mnemonic+operands
    out = []
    for l in lines:
        m = re.match(r'^  [0-9a-f]{6}:\s+([0-9a-f ]{6,8})\s*(.*)$', l)
        if not m:
            out.append(l)
        else:
            ins = m.group(2)
            # remove address operands like 4005xx / 4012xx / 4030xx
            ins = re.sub(r'\b40[0-9a-f]{4}\b', 'A', ins)
            out.append(ins)
    return out

variants = [
    "buf[i] = i * 3 + 1;",
    "buf[i] = i + i * 2 + 1;",
    "buf[i] = i + (i * 2) + 1;",
    "buf[i] = (i + i * 2) + 1;",
    "buf[i] = i * 2 + i + 1;",
    "buf[i] = 2 * i + i + 1;",
    "buf[i] = i * 3 + i - i + 1;",
    "buf[i] = (i << 1) + i + 1;",
    "buf[i] = i + (i << 1) + 1;",
    "buf[i] = i + i + i + 1;",
    "buf[i] = (i + i) + i + 1;",
    "buf[i] = (i * 3) + 1;",
    "buf[i] = 3 * i + 1;",
]
on_orig = norm(orig)
for v in variants:
    b = gen(v)
    if b is None:
        print("ERR", v); continue
    nb = norm(b)
    mark = "MATCH" if nb == on_orig else "     "
    print(f"{mark} | {v} | (righe: {len(b)})")
    if mark != "MATCH":
        import difflib
        d = [x for x in difflib.unified_diff(on_orig, nb, lineterm="", n=0) if x[0] in "+-" and not x.startswith("+++") and not x.startswith("---")]
        for x in d[:12]:
            print("      ", x)
