import subprocess, re

def dis(bin):
    return subprocess.run(["objdump","-d","-M","intel",bin],capture_output=True,text=True).stdout.splitlines()

def region(lines, start=0x400554, end=0x4005b0):
    out=[]
    for l in lines:
        m = re.match(r'^  ([0-9a-f]{6}):', l)
        if m:
            a = int(m.group(1),16)
            if start <= a < end:
                out.append(l)
    return out

def gen(body, btype="int *"):
    src = f'''#include <stdio.h>
#include <stdlib.h>
int main(int argc, char *argv[]) {{
    if (argc < 2) {{ return 1; }}
    setvbuf(stdout, NULL, _IONBF, 0);
    unsigned int n = atoi(argv[1]);
    if (n > 100) {{ puts("Troppi elementi"); return 1; }}
    unsigned char size = n * sizeof(int);
    {btype} buf = malloc(size);
    printf("Elementi: %u, byte allocati: %u\\n", n, size);
    int sum = 0;
    unsigned int i;
    for (i = 0; i < n; i++) {{
        {body}
        sum += buf[i];
    }}
    printf("Somma: %u\\n", sum);
    free(buf);
    return 0;
}}
'''
    open("bv.c","w").write(src)
    subprocess.run(["gcc","-O0","-o","bv","bv.c"],capture_output=True,text=True)
    return region(dis("bv"))

print("=== ORIG unsigned int * buf[i]=i*3+1 (per riferimento) ===")
print("\n".join(region(dis("test_O0"))))
for bt, body in [("unsigned int *","buf[i] = i * 3 + 1;"), ("int *","*(buf + i) = i * 3 + 1;")]:
    print(f"=== {bt} | {body} ===")
    print("\n".join(gen(body, bt)))
    print()
