    content: /*
 * test_O3 - reconstructed C source from the stripped binary (test_O3).
 *
 * The program reads an element count from argv[1], "allocates" a buffer using
 * only the low 8 bits of the requested byte count (an intentional overflow),
 * fills the buffer with the arithmetic sequence  3*i + 1  and prints the sum.
 *
 * Layout recovered from the .rodata section:
 *   0x401310  "Troppi elementi"
 *   0x401320  "Somma: %u\n"
 *   0x401330  "Elementi: %u, byte allocati: %u\n"
 *   0x401360  {0, 1, 2, 3}   (vectorised initial state / seed)
 *   0x401370  {1, 1, 1, 1}   (vectorised per-element offset)
 *   0x401380  {4, 4, 4, 4}   (vectorised per-element delta)
 *
 * The body of main() is the -O3 vectorised form of:  buf[i] = 3*i + 1;
 * The scalar tail (n % 4 elements) is transcribed from the unrolled guards in
 * the generated code (0x0040050e..0x00400536).
 */

#include <stdio.h>
#include <stdint.h>
#include <stdlib.h>

/* .rodata constant blocks loaded by the vectorised loop (MOVDQA). */
static const int32_t seed[4]  = { 0, 1, 2, 3 };
static const int32_t offset[4] = { 1, 1, 1, 1 };
static const int32_t delta[4]  = { 4, 4, 4, 4 };

/* Scalar value of the element at position k: 3*k + 1.
 * (state = 3*(k%4) + (k/4)*12 + 1  ==  3*k + 1 )
 */
static inline int32_t element_at(uint32_t k)
{
    return (int32_t)(3 * (k % 4) + (k / 4) * 12 + 1);
}

int main(int argc, char **argv)
{
    if (argc < 2) {
        return 1;
    }

    setvbuf(stdout, (char *)0x0, 2 /* _IONBF */, 0);

    /* n = strtol(argv[1], NULL, 10); */
    uint32_t n = (uint32_t)strtol(argv[1], 0, 10);

    if (100 < n) {
        puts("Troppi elementi");
        return 1;
    }

    /* Buffer overflow: only the low 8 bits of n*4 bytes are allocated. */
    size_t allocated = (size_t)(n * 4) & 0xff;
    int *__ptr = (int *)malloc(allocated);

    printf("Elementi: %u, byte allocati: %u\n",
           n, (uint32_t)(byte)(n * 4));

    uint32_t sum;
    if (n == 0) {
        sum = 0;
    } else if (n <= 4) {
        /* Small path: base = 0, accumulate 1, 4, 7, 10 guarded by index < n. */
        uint32_t base = 0;
        sum = 0;
        sum += 3 * base + 1;
        if (base + 1 < n) {
            sum += 3 * base + 4;
            if (base + 2 < n) {
                sum += 3 * base + 7;
                if (base + 3 < n) {
                    sum += 3 * base + 10;
                }
            }
        }
    } else {
        /* Vectorised path: process 4 elements per iteration.
         * state starts at {0,1,2,3} and advances by +4 each group, so the
         * element written at array index (4*g + lane) is  3*(4*g+lane) + 1.
         */
        int32_t st0 = seed[0];
        int32_t st1 = seed[1];
        int32_t st2 = seed[2];
        int32_t st3 = seed[3];

        uint32_t groups = n >> 2;
        int *p = __ptr;
        uint32_t acc0 = 0, acc1 = 0, acc2 = 0, acc3 = 0;

        for (uint32_t g = 0; g < groups; g++) {
            int32_t v0 = st0 * 3 + offset[0];
            int32_t v1 = st1 * 3 + offset[1];
            int32_t v2 = st2 * 3 + offset[2];
            int32_t v3 = st3 * 3 + offset[3];

            st0 += delta[0];
            st1 += delta[1];
            st2 += delta[2];
            st3 += delta[3];

            p[0] = v0;
            p[1] = v1;
            p[2] = v2;
            p[3] = v3;

            acc0 += v0;
            acc1 += v1;
            acc2 += v2;
            acc3 += v3;

            p += 4;
        }

        sum = (uint32_t)(acc0 + acc1 + acc2 + acc3);

        /* Tail: handle the remaining (n % 4) elements after base = n & ~3. */
        uint32_t base = n & 0xfffffffcu;
        if (base + 1 < n) {
            sum += 3 * base + 1;
            if (base + 2 < n) {
                sum += 3 * base + 4;
                if (base + 3 < n) {
                    sum += 3 * base + 7;
                    if (base + 4 < n) {
                        sum += 3 * base + 10;
                    }
                }
            }
        }
    }

    printf("Somma: %u\n", sum);
    free(__ptr);
    return 0;
}


