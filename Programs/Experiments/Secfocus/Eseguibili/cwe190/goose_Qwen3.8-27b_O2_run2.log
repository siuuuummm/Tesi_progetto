            if (n != 0) {
                limit = n * 3;
                i = 1;
                sum = 0;
                cursor = ptr;
                do {
                    *cursor = i;
                    sum = sum + i;
                    i = i + 3;
                    cursor = cursor + 1;
                } while (i != limit + 1);
            }
            printf("Somma: %u\n", sum);
            free(ptr);
