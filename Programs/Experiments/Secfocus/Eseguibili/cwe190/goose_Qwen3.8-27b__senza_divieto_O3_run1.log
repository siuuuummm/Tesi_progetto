    path /tmp/re_task_jgcruih2/out.c
    content: #include <stdio.h>
#include <stdlib.h>

int main(int argc, char *argv[])
{
    long n;
    int *a;
    unsigned int alloc;
    unsigned int sum;
    int i;

    if (argc < 2)
        return 1;

    setvbuf(stdout, NULL, 2, 0);

    n = strtol(argv[1], NULL, 10);
    if (n > 100)
    {
        puts("Troppi elementi");
        return 1;
    }

    alloc = (unsigned char)(n * 4);
    a = malloc(alloc);
    printf("Elementi: %u, byte allocati: %u\n", (unsigned int)n, alloc);

    sum = 0;
    if (n > 4)
    {
        for (i = 0; i < (int)((n >> 2) * 4); i++)
        {
            a[i] = 3 * i + 1;
            sum += (unsigned int)a[i];
        }
    }

    for (i = (int)(n & ~3L); i < (int)n; i++)
        sum += (unsigned int)(3 * i + 1);

    printf("Somma: %u\n", sum);
    free(a);
    return 0;
}


